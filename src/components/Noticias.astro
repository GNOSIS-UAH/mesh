---
import { getCollection } from 'astro:content';
import { textos, fecha, type Lang } from '../i18n';
interface Props { lang: Lang; max?: number }
const { lang, max = 6 } = Astro.props;
const t = textos[lang];
const noticias = (await getCollection('noticias', ({ id }) => (lang === 'en') === id.startsWith('en/')))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()).slice(0, max);
---
<div class="news">
  {noticias.length === 0 ? (
    <p class="nota">{t.sinNoticias}</p>
  ) : (
    <table>
      {noticias.map((n) => (
        <tr>
          <th scope="row">{fecha(n.data.fecha, lang, { day: 'numeric', month: 'short', year: 'numeric' })}</th>
          <td>{n.data.resumen}{n.data.url && <> <a href={n.data.url} rel="noopener">{n.data.etiqueta}</a>.</>}</td>
        </tr>
      ))}
    </table>
  )}
</div>
