---
import { textos, prefijo, rutaAlterna, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = textos[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ruta = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const pre = prefijo(lang);
const enlaces = [
  { href: '/', texto: t.nav.inicio },
  { href: '/proyecto', texto: t.nav.proyecto },
  { href: '/resultados', texto: t.nav.resultados },
  { href: '/publicaciones', texto: t.nav.publicaciones },
  { href: '/recursos', texto: t.nav.recursos },
  { href: '/equipo', texto: t.nav.equipo },
];
const sinPrefijo = ruta.replace(/^\/en(?=\/|$)/, '') || '/';
const activo = (h: string) => (h === '/' ? sinPrefijo === '/' : sinPrefijo.startsWith(h));
const otra = rutaAlterna(lang, ruta);
---
<a class="saltar" href="#contenido">{t.saltar}</a>
<header class="navbar">
  <div class="contenedor navbar__fila">
    <a class="navbar__marca" href={`${base}${pre}/`}><span class="negrita">MESH</span></a>
    <nav aria-label="Principal">
      <ul class="navbar__menu">
        {enlaces.map((e) => (
          <li><a href={`${base}${pre}${e.href === '/' ? '/' : e.href}`} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a></li>
        ))}
        <li><a href={`${base}${otra}`} hreflang={t.cambioIdioma.lang} lang={t.cambioIdioma.lang} title={t.cambioIdioma.titulo}>{t.cambioIdioma.etiqueta}</a></li>
      </ul>
    </nav>
  </div>
</header>
